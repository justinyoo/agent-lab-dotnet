<div class="mb-screen">
    <div class="mb-shell">
        <div class="mb-card">

            <!-- Identity area -->
            <div class="mb-identity">
                <div class="mb-badge">Mission Brief</div>
                <h1 class="mb-title">SOC OPS</h1>
                <p class="mb-subtitle">Social Bingo · Field Edition</p>
            </div>

            <!-- Feature chips: locate → confirm → achieve loop -->
            <div class="mb-chips-section">
                <p class="mb-section-label">Objective Loop</p>
                <div class="mb-chips">
                    <div class="mb-chip">
                        <span class="mb-chip-icon">🔍</span>
                        <span class="mb-chip-verb">Locate</span>
                        <span class="mb-chip-desc">Find someone in the room who matches the square</span>
                    </div>
                    <div class="mb-chip">
                        <span class="mb-chip-icon">✅</span>
                        <span class="mb-chip-verb">Confirm</span>
                        <span class="mb-chip-desc">Tap to mark the match and lock it in</span>
                    </div>
                    <div class="mb-chip">
                        <span class="mb-chip-icon">🏆</span>
                        <span class="mb-chip-verb">Achieve</span>
                        <span class="mb-chip-desc">Complete five in a row to claim victory</span>
                    </div>
                </div>
            </div>

            <!-- Briefing checklist -->
            <div class="mb-rules-section">
                <p class="mb-section-label">Briefing Checklist</p>
                <ul class="mb-checklist" role="list">
                    <li class="mb-checklist-item">
                        <span class="mb-check-num" aria-hidden="true">01</span>
                        <span class="mb-check-text">Mingle with the room and find someone who fits each square</span>
                    </li>
                    <li class="mb-checklist-item">
                        <span class="mb-check-num" aria-hidden="true">02</span>
                        <span class="mb-check-text">Tap the square to mark it — each match is locked in instantly</span>
                    </li>
                    <li class="mb-checklist-item">
                        <span class="mb-check-num" aria-hidden="true">03</span>
                        <span class="mb-check-text">Complete a full row, column, or diagonal to win the round</span>
                    </li>
                </ul>
            </div>

            <!-- CTA -->
            <div class="mb-cta-section">
                <button
                    @onclick="OnStart"
                    class="mb-btn-deploy"
                    aria-label="Begin Mission — start the game">
                    Begin Mission
                </button>
                <p class="mb-hint">One board per agent · Good luck out there</p>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
