<div class="arc-screen">
    <div class="arc-shell">
        <div class="arc-card">

            <div class="arc-brand">
                <p class="arc-kicker">Social Ice-Breaker</p>
                <h1 class="arc-title">SOC<span class="arc-title-accent">OPS</span></h1>
                <p class="arc-hook">Find the humans. Fill the grid. Win the room.</p>
            </div>

            <div class="arc-rules" aria-label="How to play">
                <div class="arc-rule">
                    <span class="arc-rule-icon" aria-hidden="true">▶</span>
                    <span>Find someone who matches each square</span>
                </div>
                <div class="arc-rule">
                    <span class="arc-rule-icon" aria-hidden="true">▶</span>
                    <span>Tap the square to mark it</span>
                </div>
                <div class="arc-rule">
                    <span class="arc-rule-icon" aria-hidden="true">▶</span>
                    <span>5 in a row wins — BINGO!</span>
                </div>
            </div>

            <button
                @onclick="OnStart"
                class="arc-cta w-full"
                aria-label="Start game">
                Start Game
            </button>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
